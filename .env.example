# Copier en .env (ignoré par git). Cf. AGENTS.md §4.
RUSTHOME_ENV=development
# dev = utilisateur local hugo (admin), refusé en production
# oidc = connexion via Authelia (cf. docs/authelia.md) ; none = tout refuser
RUSTHOME_AUTH=dev
# --- OIDC (si RUSTHOME_AUTH=oidc) ---
# RUSTHOME_PUBLIC_URL=https://maison.example.org
# RUSTHOME_OIDC_ISSUER=https://auth.example.org
# RUSTHOME_OIDC_CLIENT_ID=rusthome
# RUSTHOME_OIDC_CLIENT_SECRET=
# Utilisateur Authelia -> rôle (admin | resident | display). Inconnu = refusé.
# RUSTHOME_ROLES=admin=admin,hugo=resident,sokhna=resident
# Tableau imposé aux comptes « display » (tablette murale), ouvert en kiosque :
# RUSTHOME_DISPLAY_DASHBOARD=dashboard-nspanel
RUSTHOME_BIND=127.0.0.1:8124
RUSTHOME_DB=sqlite://var/rusthome.db
RUSTHOME_TZ=Europe/Paris
RUSTHOME_RETENTION_DAYS=10

# Miroir Home Assistant en LECTURE SEULE (jeton longue durée créé dans le profil HA).
# Laisser vide pour démarrer avec les données de démo (RUSTHOME_FIXTURES).
HA_URL=
HA_TOKEN=
RUSTHOME_FIXTURES=deploy/dev/fixtures.json

# --- MQTT (M2) ---
# Broker actuel (add-on Mosquitto du Pi). En dev, lecture seule imposée par le code :
# RustHome s'abonne mais ne publie jamais tant que RUSTHOME_MQTT_READ_ONLY=true.
RUSTHOME_MQTT_URL=mqtt://192.168.1.35:1883
RUSTHOME_MQTT_USERNAME=rusthome
RUSTHOME_MQTT_PASSWORD=
RUSTHOME_MQTT_READ_ONLY=true
# Frigate (M2) : API HTTP (port 5000 non authentifié) + MQTT ci-dessus
RUSTHOME_FRIGATE_URL=http://192.168.1.25:5000
# RUSTHOME_FRIGATE_TOPIC_PREFIX=frigate

# --- ESPHome Builder (M6, spec §5.3 bis) ---
# Conteneur de dev lancé par `just dev-deps` (port local 6052, projets dans var/esphome).
RUSTHOME_ESPHOME_URL=http://127.0.0.1:6052
# Projets en lecture seule (défaut : nœuds de l'alarme) et projets installables
# sans fil (défaut : le banc de test). Ne modifier que sur décision de Hugo.
# RUSTHOME_ESPHOME_LOCKED=lecteur-alarme,tag-reader
# RUSTHOME_ESPHOME_FLASHABLE=test-nfc
# Seules adresses jointes en Wi-Fi (installation, logs) : une IP fixe par projet.
# Jamais une adresse saisie dans l'interface ni un nom .local. Interdit pour l'alarme.
# RUSTHOME_ESPHOME_ADDRESSES=test-nfc@192.168.1.80
# Topic racine de Zigbee2MQTT (défaut : zigbee2mqtt)
# RUSTHOME_Z2M_BASE_TOPIC=zigbee2mqtt

# --- Portainer (M2, lecture seule : le client ne fait que des GET) ---
# RUSTHOME_PORTAINER_URL=https://192.168.1.25:9443
# RUSTHOME_PORTAINER_TOKEN=
# Certificat auto-signé de Portainer : nécessaire en HTTPS sur :9443
# RUSTHOME_PORTAINER_TLS_INSECURE=true

# --- Hue (M2) : clé créée en appuyant sur le bouton du pont ---
# RUSTHOME_HUE_URL=https://192.168.1.247
# RUSTHOME_HUE_KEY=
# Lecture seule par défaut : aucune lumière n'est commandée pendant le dev.
RUSTHOME_HUE_READ_ONLY=true

# --- Automatisations (M3) ---
# Blueprints HA (copiés depuis /config/blueprints/automation/…), développés à l'import
# RUSTHOME_BLUEPRINTS_DIR=var/blueprints

RUST_LOG=info,sqlx=warn
